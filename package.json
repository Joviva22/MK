{
  "name": "md-editor-local",
  "version": "1.0.0",
  "description": "Editor de Markdown sencillo para usar en local, sin depender de servicios externos ni conexión a internet.",
  "main": "src/main.js",
  "desktopName": "mk-editor.desktop",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "lint": "eslint .",
    "dist": "electron-builder --linux AppImage"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^5.65.16",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "lucide": "^1.43.0",
    "mammoth": "^1.12.2",
    "marked": "^12.0.2",
    "mermaid": "^11.17.2",
    "node-pty": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "sql.js": "^1.14.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "node-pty@1.1.0": true
  },
  "build": {
    "appId": "local.mk.editor",
    "productName": "MK",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "executableName": "mk-editor",
      "icon": "build/icon.png",
      "mimeTypes": [
        "text/markdown",
        "text/x-markdown"
      ],
      "syncDesktopName": true
    }
  }
}
