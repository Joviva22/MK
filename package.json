{
  "name": "md-editor-local",
  "version": "2.1.0",
  "description": "Editor de Markdown sencillo para usar en local, sin depender de servicios externos ni conexión a internet.",
  "main": "src/main.js",
  "desktopName": "mk-editor.desktop",
  "scripts": {
    "start": "electron .",
    "pretest": "npm run build:cm6 && npm run build:drawing",
    "test": "node test/run.js",
    "test:unit": "node --test test/unit/",
    "bench": "node test/bench.js",
    "lint": "eslint .",
    "build:cm6": "node scripts/build-cm6.js",
    "build:drawing": "node scripts/build-drawing.js",
    "test:cm6": "electron test/run-cm6-shim.js",
    "pretest:cm6": "npm run build:cm6",
    "predist": "npm run build:cm6 && npm run build:drawing",
    "dist": "electron-builder --linux AppImage",
    "install-desktop": "node scripts/install-desktop.js",
    "test:office": "MK_TEST_SCRIPT=office node test/run.js",
    "pretest:office": "npm run build:cm6 && npm run build:drawing",
    "test:office-recovery": "node scripts/check-office-recovery.js",
    "pretest:office-recovery": "npm run build:cm6 && npm run build:drawing"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@excalidraw/excalidraw": "0.18.1",
    "@lezer/markdown": "^1.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^5.65.16",
    "dictionary-es": "^4.0.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.16",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "lucide": "^1.43.0",
    "mammoth": "^1.12.2",
    "marked": "^12.0.2",
    "mermaid": "^11.17.2",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.0.12",
    "nspell": "^2.1.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "^4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "^1.14.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.19",
      "sass": "1.105.1"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron@44.4.5": true
  },
  "build": {
    "appId": "local.mk.editor",
    "productName": "MK",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "node_modules/**/*",
      "package.json",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "executableName": "mk-editor",
      "icon": "build/icon.png",
      "mimeTypes": [
        "text/markdown",
        "text/x-markdown"
      ],
      "syncDesktopName": true
    }
  }
}
